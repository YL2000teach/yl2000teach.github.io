{
  "rules": {
    "sessions": {
      "$session": {
        "state": {
          ".read": true,
          ".write": "auth != null && auth.token.email === 'TEACHER_EMAIL_HERE'"
        },
        "votes": {
          ".read": true,
          ".write": "auth != null && auth.token.email === 'TEACHER_EMAIL_HERE'",
          "$question": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('sessions').child($session).child('state/open').val() === true && root.child('sessions').child($session).child('state/current').val() === $question",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            }
          }
        }
      }
    }
  }
}
